{
  "schemaVersion": 2,
  "product": "HarnessDock",
  "version": "0.1.5",
  "channel": "rc",
  "publication": {
    "tagTemplate": "v{version}-{prerelease}",
    "githubPrerelease": true,
    "replaceablePrerelease": false,
    "candidateWorkflow": ".github/workflows/tauri-candidate.yml",
    "requiredSameShaWorkflows": [
      ".github/workflows/ci.yml",
      ".github/workflows/windows-packaged-startup.yml"
    ]
  },
  "shell": {
    "package": "@dsh/plugin-harness-shell",
    "version": "0.1.5",
    "apiVersion": 1
  },
  "prerelease": "rc.1",
  "runtime": {
    "version": "0.1.5-rc.1",
    "gitTag": "dsh-v0.1.5-rc.1",
    "gitCommit": "183f08e9c6dde7e36cd2318eaee70b0da08fb35e"
  },
  "targets": {
    "windows-x64": {
      "platform": "win32",
      "arch": "x64",
      "runtimeMode": "sealed-local",
      "runtimeKey": "win32-x64",
      "candidateRunner": "windows-latest",
      "bundles": ["nsis"],
      "candidateArtifact": "tauri-desktop-win-x64",
      "startupGate": "installed",
      "assets": [
        {
          "match": "*setup.exe",
          "output": "HarnessDock-{version}-windows-x64-setup.exe"
        }
      ]
    },
    "linux-x64": {
      "platform": "linux",
      "arch": "x64",
      "runtimeMode": "sealed-local",
      "runtimeKey": "linux-x64",
      "candidateRunner": "ubuntu-22.04",
      "bundles": ["deb", "appimage"],
      "candidateArtifact": "tauri-desktop-linux-x64",
      "startupGate": "runtime-smoke",
      "assets": [
        {
          "match": "*.deb",
          "output": "HarnessDock-{version}-linux-x64.deb"
        },
        {
          "match": "*.AppImage",
          "output": "HarnessDock-{version}-linux-x64.AppImage"
        }
      ]
    },
    "macos-x64": {
      "platform": "darwin",
      "arch": "x64",
      "runtimeMode": "sealed-local",
      "runtimeKey": "darwin-x64",
      "candidateRunner": "macos-15-intel",
      "bundles": ["app"],
      "candidateArtifact": "tauri-desktop-mac-x64",
      "startupGate": "runtime-smoke",
      "assets": [
        {
          "match": "*.dmg",
          "output": "HarnessDock-{version}-macos-x64.dmg"
        },
        {
          "match": "*.app.tar.gz",
          "output": "HarnessDock-{version}-macos-x64.app.tar.gz"
        }
      ]
    },
    "macos-arm64": {
      "platform": "darwin",
      "arch": "arm64",
      "runtimeMode": "sealed-local",
      "runtimeKey": "darwin-arm64",
      "candidateRunner": "macos-latest",
      "bundles": ["app"],
      "candidateArtifact": "tauri-desktop-mac-arm64",
      "startupGate": "runtime-smoke",
      "assets": [
        {
          "match": "*.dmg",
          "output": "HarnessDock-{version}-macos-arm64.dmg"
        },
        {
          "match": "*.app.tar.gz",
          "output": "HarnessDock-{version}-macos-arm64.app.tar.gz"
        }
      ]
    },
    "android-arm64": {
      "platform": "android",
      "arch": "arm64",
      "runtimeMode": "remote-gateway",
      "candidateRunner": "ubuntu-latest",
      "candidateArtifact": "tauri-android-arm64-candidate",
      "startupGate": "package-contract",
      "assets": [
        {
          "match": "*.apk",
          "output": "HarnessDock-{version}-android-arm64-release.apk"
        },
        {
          "match": "*.aab",
          "output": "HarnessDock-{version}-android-arm64-release.aab"
        }
      ]
    },
    "ios-arm64-simulator": {
      "platform": "ios",
      "arch": "arm64",
      "runtimeMode": "remote-gateway",
      "candidateRunner": "macos-latest",
      "candidateArtifact": "tauri-ios-simulator-candidate",
      "startupGate": "package-contract",
      "assets": [
        {
          "match": "*.zip",
          "output": "HarnessDock-{version}-ios-arm64-simulator.zip"
        }
      ]
    }
  },
  "runtimeBundles": {
    "win32-x64": {
      "platform": "win32",
      "arch": "x64",
      "prepareRunner": "ubuntu-latest",
      "candidateArtifact": "tauri-runtime-win-x64",
      "output": "HarnessDock-runtime-{runtimeVersion}-win32-x64.tar.gz"
    },
    "linux-x64": {
      "platform": "linux",
      "arch": "x64",
      "prepareRunner": "ubuntu-latest",
      "candidateArtifact": "tauri-runtime-linux-x64",
      "output": "HarnessDock-runtime-{runtimeVersion}-linux-x64.tar.gz"
    },
    "darwin-x64": {
      "platform": "darwin",
      "arch": "x64",
      "prepareRunner": "macos-15-intel",
      "candidateArtifact": "tauri-runtime-mac-x64",
      "output": "HarnessDock-runtime-{runtimeVersion}-darwin-x64.tar.gz"
    },
    "darwin-arm64": {
      "platform": "darwin",
      "arch": "arm64",
      "prepareRunner": "macos-latest",
      "candidateArtifact": "tauri-runtime-mac-arm64",
      "output": "HarnessDock-runtime-{runtimeVersion}-darwin-arm64.tar.gz"
    }
  },
  "checksums": {
    "algorithm": "sha256",
    "file": "SHA256SUMS"
  },
  "origin": "packages/docs-sync/origin.json"
}

