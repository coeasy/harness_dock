{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HarnessDock",
  "version": "0.2.0",
  "identifier": "com.harnessdock.client",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HarnessDock",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 540,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost https: http:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "HarnessDock",
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness cross-platform client",
    "longDescription": "HarnessDock is a Tauri 2 client for the official DeepSeek Harness Web UI with a pinned local desktop runtime and paired remote mobile access.",
    "resources": {
      "resources/origin.json": "origin.json",
      "resources/gateway-host.mjs": "gateway-host.mjs",
      "../../packages/plugin-embedded-client/lib/index.js": "embedded-client/index.js",
      "resources/dsh-runtime/": "dsh-runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
