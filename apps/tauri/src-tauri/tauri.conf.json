{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HarnessDock",
  "version": "0.1.2",
  "identifier": "com.harnessdock.client",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "pnpm --filter @dsh/tauri prepare:icons",
    "beforeBuildCommand": "pnpm --filter @dsh/tauri prepare:icons"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "HarnessDock · DeepSeek Harness",
        "url": "splash.html",
        "visible": true,
        "center": true,
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "capabilities": ["local-main", "harness-shell", "shell-settings", "mobile-remote"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "category": "DeveloperTool",
    "shortDescription": "HarnessDock DeepSeek Harness client",
    "longDescription": "Full-only Tauri Native Host for DeepSeek Harness with sealed local Runtime and secure Rust-native mobile Gateway pairing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../packages/docs-sync/origin.json": "origin.json",
      "../../../packages/plugin-embedded-client/lib/index.js": "plugin-embedded-client/index.js",
      "../../../packages/plugin-harness-shell/lib/index.js": "plugin-harness-shell/index.js",
      "../../../packages/plugin-harness-shell/web/shell.js": "plugin-harness-shell/web/shell.js",
      "resources/": ""
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese", "TradChinese"],
        "displayLanguageSelector": false
      }
    },
    "android": { "minSdkVersion": 24 },
    "iOS": { "minimumSystemVersion": "14.0" }
  }
}
