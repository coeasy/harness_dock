{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "harness-shell",
  "description": "Minimal capability for the loopback Harness WebView shell. It can open the separate local Plugin Diagnostics window and operate only the owning Harness window.",
  "local": false,
  "platforms": ["linux", "macOS", "windows"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://127.0.0.1:*",
      "http://localhost:*/*",
      "http://localhost:*",
      "https://127.0.0.1:*/*",
      "https://127.0.0.1:*",
      "https://localhost:*/*",
      "https://localhost:*"
    ]
  },
  "windows": ["harness"],
  "permissions": ["core:default", "harness-shell"]
}
