{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-main",
  "description": "Local bundled HarnessDock control capability. Remote Harness/Gateway documents never receive Tauri IPC permissions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "platform-info",
    "gateway-health",
    "gateway-pair",
    "gateway-host",
    "harness-window",
    "splash-status",
    "runtime-status",
    "runtime-start",
    "runtime-stop",
    "runtime-maintenance",
    "startup-recovery-status"
  ]
}
