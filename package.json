{
  "name": "harnessdock",
  "version": "0.2.0",
  "private": true,
  "description": "DeepSeek Harness full-capability client: embed official Web UI, pin docs+runtime to the same exact version.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check:versions": "node scripts/check-versions.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:embedded-runtime": "node scripts/check-embedded-runtime.mjs",
    "generate:host-protocol": "node scripts/generate-host-protocol.mjs",
    "check:host-protocol": "node scripts/generate-host-protocol.mjs --check",
    "perf:report": "node scripts/perf-report.mjs",
    "mark:released": "node scripts/mark-released.mjs",
    "tauri:dev": "pnpm --filter @dsh/tauri tauri:dev",
    "tauri:build": "pnpm --filter @dsh/tauri tauri:build",
    "tauri:check": "pnpm --filter @dsh/tauri tauri:check",
    "e2e": "pnpm --filter @dsh/parity-tests e2e",
    "build": "pnpm -r --if-present run build",
    "setup": "node scripts/bootstrap.mjs",
    "sync:dsh": "pnpm --filter @dsh/docs-sync start",
    "prepare:runtime": "pnpm --filter @dsh/client-runtime bundle-runtime",
    "build:desktop": "pnpm tauri:build",
    "pack:vscode": "pnpm --filter ./apps/vscode run pack:vsix",
    "parity": "pnpm --filter @dsh/parity-tests test",
    "dev:dsh": "node --import tsx scripts/dev-dsh.mjs",
    "start:desktop": "pnpm tauri:dev",
    "check:shell-package": "pnpm --filter @dsh/plugin-harness-shell build && node scripts/check-shell-package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
