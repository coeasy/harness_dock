{
  "name": "harnessdock",
  "version": "0.2.0",
  "private": true,
  "description": "DeepSeek Harness Tauri 2 client for Windows, macOS, Linux, Android and iOS.",
  "type": "module",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check:versions": "node scripts/check-versions.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:size": "node scripts/check-size.mjs",
    "perf:report": "node scripts/perf-report.mjs",
    "mark:released": "node scripts/mark-released.mjs",
    "e2e": "pnpm --filter ./tests/e2e test",
    "build": "pnpm -r --if-present run build",
    "setup": "node scripts/bootstrap.mjs",
    "sync:dsh": "pnpm --filter @dsh/docs-sync start",
    "prepare:runtime": "pnpm --filter @dsh/client-runtime bundle-runtime",
    "build:tauri": "cargo tauri build --manifest-path apps/tauri/src-tauri/Cargo.toml",
    "build:android": "cargo tauri android build --manifest-path apps/tauri/src-tauri/Cargo.toml --apk --aab --ci",
    "build:ios": "cargo tauri ios build --manifest-path apps/tauri/src-tauri/Cargo.toml --ci",
    "check:tauri": "cargo check --manifest-path apps/tauri/src-tauri/Cargo.toml --all-targets",
    "pack:vscode": "pnpm --filter ./apps/vscode run pack:vsix",
    "parity": "pnpm --filter @dsh/parity-tests test",
    "dev:dsh": "node --import tsx scripts/dev-dsh.mjs",
    "legacy:electron:start": "pnpm --filter @dsh/desktop start",
    "legacy:electron:pack": "pnpm --filter @dsh/desktop pack:current"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild", "electron"] }
}
